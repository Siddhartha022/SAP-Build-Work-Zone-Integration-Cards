
{
  "_version": "1.15.0",
  "sap.app": {
    "id": "ns.integrationdemo2",
    "type": "card",
    "title": "Northwind",
    "subTitle": "Product List",
    "applicationVersion": {
      "version": "1.0.0"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "phone": true,
      "tablet": true
    },
    "icons": {
      "icon": "sap-icon://table-view"
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "ns.integrationdemo2.View",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.71",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "config": {
      "sample": {
        "stretch": true,
        "files": [
          "Card.controller.js"
        ]
      }
    }
  },
  "sap.card": {
    "type": "Component",
    "designtime": "dt/configuration",
    "header": {
      "icon": {
        "src": "sap-icon://table-view"
      },
      "title": "Northwind",
      "subTitle": ""
    },
    "content": {
      "minHeight": "20rem"
    }
  },
  "sap.platform.mobilecards": {
    "compatible": false
  }
}
